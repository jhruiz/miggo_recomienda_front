# Variables de entorno del frontend (Vite)
# Copia este archivo a `.env` y ajusta los valores según tu entorno local.
# Todas las variables expuestas al cliente deben llevar el prefijo VITE_.

# Base URL de la API REST del backend (incluye el prefijo de versión /api/v1)
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Laravel Reverb (servidor WebSocket). Deben coincidir con la config del backend.
VITE_REVERB_APP_KEY="miggo-local-key"
VITE_REVERB_HOST="127.0.0.1"
VITE_REVERB_PORT="8080"
